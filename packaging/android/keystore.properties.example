# Copy to packaging/android/keystore.properties (gitignored) after
# packaging/android/new-keystore.sh, or let that script write the copy.
# storeFile is an absolute path. The passwords are the release key's passwords.
storeFile=/home/patrik/.config/holdover/holdover-release.keystore
storePassword=replace-me
keyAlias=holdover
keyPassword=replace-me
