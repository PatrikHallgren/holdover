{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Holdover",
  "version": "1.5.2",
  "identifier": "se.hallgren.holdover",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Holdover 1.5.2",
        "width": 1120,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": false,
    "android": {
      "minSdkVersion": 26,
      "versionCode": 1005002
    }
  }
}
